@inject BugContextCollector Collector
@inject MultiDestinationDispatcher Dispatcher
@inject BugSnapOptions Options
@inject SeverityDetector SeverityDetectorService

@if (Visible)
{
    <div class="bs-backdrop" @onclick="HandleBackdropClick">
        <div class="bs-modal" @onclick:stopPropagation>
            <div class="bs-modal-header">
                <span class="bs-modal-title">Reportar problema</span>
                <button class="bs-close-btn" @onclick="HandleCancel" aria-label="Fechar">&times;</button>
            </div>

            <div class="bs-modal-body">
                @if (_rateLimited)
                {
                    <div class="bs-alert bs-alert-warning">
                        Aguarde @_rateLimitSecondsRemaining segundo(s) antes de enviar outro relatório.
                    </div>
                }

                @if (_submitSuccess)
                {
                    <div class="bs-alert bs-alert-success">
                        Problema reportado! Obrigado.
                    </div>
                }

                @if (_submitError is not null)
                {
                    <div class="bs-alert bs-alert-error">
                        Erro ao enviar. Tente novamente.
                    </div>
                }

                <div class="bs-field">
                    <label class="bs-label" for="bs-description">Descreva o problema</label>
                    <textarea id="bs-description" class="bs-textarea" rows="5"
                              placeholder="O que aconteceu?"
                              @bind="_description" @bind:event="oninput" maxlength="2000"></textarea>
                    @if (string.IsNullOrWhiteSpace(_description))
                    {
                        <small class="bs-helper">Descreva o problema para habilitar o envio.</small>
                    }
                </div>

                <div class="bs-field">
                    <label class="bs-label" for="bs-severity">Gravidade</label>
                    <select id="bs-severity" class="bs-select" @bind="_selectedSeverity">
                        <option value="@BugSnapSeverity.Low">Baixa</option>
                        <option value="@BugSnapSeverity.Medium">Média</option>
                        <option value="@BugSnapSeverity.High">Alta</option>
                        <option value="@BugSnapSeverity.Critical">Crítica</option>
                    </select>
                </div>

                <div class="bs-field">
                    <span class="bs-chip">Categoria detectada: @CategoryLabel(_detectedCategory)</span>
                    <label class="bs-label" for="bs-category">Categoria</label>
                    <select id="bs-category" class="bs-select" @bind="_selectedCategory">
                        @foreach (var cat in _categories)
                        {
                            <option value="@cat">@CategoryLabel(cat)</option>
                        }
                    </select>
                </div>

                <div class="bs-field">
                    <button type="button" class="bs-collapse-toggle" @onclick="ToggleOptionalFields">
                        @(_optionalFieldsExpanded ? "▼" : "▶") Detalhes adicionais (opcional)
                    </button>
                    @if (_optionalFieldsExpanded)
                    {
                        <div class="bs-collapse-body">
                            <label class="bs-label" for="bs-steps">Passos para reproduzir (opcional)</label>
                            <textarea id="bs-steps" class="bs-textarea" rows="3"
                                      placeholder="1. Abri a tela... 2. Cliquei em... 3. O erro apareceu..."
                                      @bind="_stepsToReproduce" @bind:event="oninput" maxlength="2000"></textarea>

                            <label class="bs-label" for="bs-expected">O que você esperava / impacto (opcional)</label>
                            <textarea id="bs-expected" class="bs-textarea" rows="3"
                                      placeholder="Eu esperava que... O impacto é..."
                                      @bind="_expectedOrImpact" @bind:event="oninput" maxlength="2000"></textarea>
                        </div>
                    }
                </div>

                @if (_context is not null)
                {
                    <div class="bs-preview">
                        <button type="button" class="bs-collapse-toggle" @onclick="TogglePreview">
                            @(_previewExpanded ? "▼" : "▶") O que será enviado
                        </button>
                        @if (_previewExpanded)
                        {
                            <ul class="bs-preview-list">
                                <li>Tela: @_context.CurrentRoute</li>
                                <li>@_context.RecentJsErrors.Count erro(s) técnico(s)</li>
                                <li>@_context.RecentRequests.Count requisição(ões) capturada(s)</li>
                                <li>Dados sensíveis mascarados automaticamente</li>
                                <li>Gravidade detectada: @SeverityLabel(_detectedSeverity)</li>
                                <li>Categoria detectada: @CategoryLabel(_detectedCategory)</li>
                            </ul>

                            <button type="button" class="bs-collapse-toggle" @onclick="ToggleTechnicalDetails">
                                @(_technicalDetailsExpanded ? "▼" : "▶") Ver detalhes técnicos
                            </button>
                            @if (_technicalDetailsExpanded)
                            {
                                <pre class="bs-preview-json">@_previewJson</pre>
                            }
                        }
                    </div>
                }

                <div class="bs-screenshot-row">
                    <InputFile id="bs-screenshot-input" class="bs-file-input-hidden" accept="image/*" OnChange="HandleFileSelected" />
                    <label for="bs-screenshot-input" class="bs-screenshot-btn" title="Anexar screenshot">
                        📷
                        @if (_screenshotFileName is not null)
                        {
                            <span class="bs-screenshot-name">@_screenshotFileName</span>
                        }
                        else
                        {
                            <span class="bs-screenshot-label">Screenshot (opcional)</span>
                        }
                    </label>
                </div>
            </div>

            <div class="bs-modal-footer">
                <button class="bs-btn bs-btn-secondary" type="button" @onclick="HandleCancel"
                        disabled="@_submitting">
                    Cancelar
                </button>
                <button class="bs-btn bs-btn-primary" type="button" @onclick="HandleSubmit"
                        disabled="@(_submitting || _rateLimited || string.IsNullOrWhiteSpace(_description))">
                    @if (_submitting)
                    {
                        <span>Enviando...</span>
                    }
                    else
                    {
                        <span>Enviar</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback<BugReport> OnReportSubmitted { get; set; }

    private static readonly BugSnapCategory[] _categories = Enum.GetValues<BugSnapCategory>();

    private string _description = "";
    private string? _stepsToReproduce;
    private string? _expectedOrImpact;
    private byte[]? _screenshotBytes;
    private string? _screenshotFileName;

    private BugContextSnapshot? _context;
    private BugSnapSeverity _detectedSeverity = BugSnapSeverity.Low;
    private BugSnapSeverity _selectedSeverity = BugSnapSeverity.Low;
    private BugSnapCategory _detectedCategory = BugSnapCategory.Other;
    private BugSnapCategory _selectedCategory = BugSnapCategory.Other;

    private bool _previewExpanded;
    private string _previewJson = "{}"; // materialized when the technical panel is opened (avoids re-sanitizing on every keystroke)
    private bool _technicalDetailsExpanded;
    private bool _optionalFieldsExpanded;

    private bool _submitting;
    private bool _submitSuccess;
    private string? _submitError;
    private bool _rateLimited;
    private int _rateLimitSecondsRemaining;

    // Instance-scoped rate-limit gate. Was static, which made every modal instance share one
    // process-wide cooldown — an unrelated modal submit could silently block this user's first
    // manual submit. (Auto-capture has its own AutoCaptureThrottle and never touched this field.)
    // Per-instance keeps the manual flow's rate limit independent.
    private DateTime _lastSubmitTime = DateTime.MinValue;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && _context is null)
        {
            await LoadContextAsync();
        }
    }

    private async Task LoadContextAsync()
    {
        try
        {
            _context = await Collector.CollectAsync();
        }
        catch
        {
            // Context collection failing should not block the form
            _context = new BugContextSnapshot();
        }

        _detectedSeverity = SeverityDetectorService.Detect(_context);
        _selectedSeverity = _detectedSeverity;
        _detectedCategory = _context.SuggestedCategory ?? BugSnapCategory.Other;
        _selectedCategory = _detectedCategory;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        const long maxSize = 2 * 1024 * 1024; // 2MB
        if (file.Size > maxSize) return;

        using var stream = file.OpenReadStream(maxSize);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _screenshotBytes = ms.ToArray();
        _screenshotFileName = file.Name;
    }

    private void TogglePreview() => _previewExpanded = !_previewExpanded;
    private void ToggleTechnicalDetails()
    {
        _technicalDetailsExpanded = !_technicalDetailsExpanded;
        // Materialize the sanitized preview once on open (snapshot), not on every render/keystroke.
        if (_technicalDetailsExpanded)
            _previewJson = BuildSanitizedPreviewJson();
    }
    private void ToggleOptionalFields() => _optionalFieldsExpanded = !_optionalFieldsExpanded;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_description))
            return;

        var secondsSinceLast = (DateTime.UtcNow - _lastSubmitTime).TotalSeconds;
        if (secondsSinceLast < Options.RateLimitSeconds)
        {
            _rateLimited = true;
            _rateLimitSecondsRemaining = (int)Math.Ceiling(Options.RateLimitSeconds - secondsSinceLast);
            return;
        }

        _submitting = true;
        _submitSuccess = false;
        _submitError = null;
        _rateLimited = false;

        try
        {
            if (_context is null)
                _context = await Collector.CollectAsync();

            var maxLen = 255;
            var raw = _description.Trim();
            string title;
            if (raw.Length > maxLen)
            {
                var cut = raw.LastIndexOf(' ', maxLen);
                title = cut > 20 ? raw[..cut] + "..." : raw[..maxLen] + "...";
            }
            else
            {
                title = raw;
            }
            if (string.IsNullOrEmpty(title)) title = "Bug report";

            var steps = string.IsNullOrWhiteSpace(_stepsToReproduce) ? null : _stepsToReproduce.Trim();
            var expected = string.IsNullOrWhiteSpace(_expectedOrImpact) ? null : _expectedOrImpact.Trim();

            var report = new BugReport
            {
                Title = title,
                Description = _description.Trim(),
                Severity = _selectedSeverity,
                AutoDetectedSeverity = _detectedSeverity.ToString(),
                Category = _selectedCategory,
                StepsToReproduce = steps,
                ExpectedOrImpact = expected,
                Screenshot = _screenshotBytes,
                ScreenshotFileName = _screenshotFileName,
                Fingerprint = FingerprintGenerator.Generate(_context, _description.Trim()),
                Context = _context
            };

            var results = await Dispatcher.DispatchAsync(report);

            _lastSubmitTime = DateTime.UtcNow;

            var anySuccess = results.Any(r => r.Success);
            if (anySuccess)
            {
                _submitSuccess = true;
                await OnReportSubmitted.InvokeAsync(report);
                ResetForm();
            }
            else
            {
                var errors = results.Where(r => !r.Success).Select(r => r.Error).Where(e => e is not null);
                _submitError = string.Join("; ", errors);
                if (string.IsNullOrEmpty(_submitError))
                    _submitError = "Falha ao enviar para todos os destinos.";
            }
        }
        catch (Exception ex)
        {
            _submitError = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private void HandleCancel()
    {
        ResetForm();
        VisibleChanged.InvokeAsync(false);
    }

    private void HandleBackdropClick()
    {
        if (!_submitting)
            HandleCancel();
    }

    private void ResetForm()
    {
        _description = "";
        _stepsToReproduce = null;
        _expectedOrImpact = null;
        _screenshotBytes = null;
        _screenshotFileName = null;
        _context = null;
        _detectedSeverity = BugSnapSeverity.Low;
        _selectedSeverity = BugSnapSeverity.Low;
        _detectedCategory = BugSnapCategory.Other;
        _selectedCategory = BugSnapCategory.Other;
        _previewExpanded = false;
        _technicalDetailsExpanded = false;
        _optionalFieldsExpanded = false;
        _submitSuccess = false;
        _submitError = null;
        _rateLimited = false;
    }

    private static string SeverityLabel(BugSnapSeverity severity) => severity switch
    {
        BugSnapSeverity.Low => "Baixa",
        BugSnapSeverity.Medium => "Média",
        BugSnapSeverity.High => "Alta",
        BugSnapSeverity.Critical => "Crítica",
        _ => severity.ToString()
    };

    private static string CategoryLabel(BugSnapCategory category) => category switch
    {
        BugSnapCategory.UI => "Interface",
        BugSnapCategory.API => "API",
        BugSnapCategory.Auth => "Autenticação",
        BugSnapCategory.Performance => "Desempenho",
        BugSnapCategory.SignalR => "SignalR",
        BugSnapCategory.Data => "Dados",
        BugSnapCategory.Integration => "Integração",
        BugSnapCategory.Other => "Outro",
        _ => category.ToString()
    };

    // Builds the JSON shown under "Ver detalhes técnicos" from a sanitized COPY of the
    // context, so previewing never mutates the live context the user is still editing
    // and never bypasses Rule 5 (sanitization is mandatory before display/send).
    private string BuildSanitizedPreviewJson()
    {
        if (_context is null) return "{}";

        var previewReport = new BugReport
        {
            Title = _description.Trim(),
            Description = _description.Trim(),
            Severity = _selectedSeverity,
            AutoDetectedSeverity = _detectedSeverity.ToString(),
            Category = _selectedCategory,
            StepsToReproduce = string.IsNullOrWhiteSpace(_stepsToReproduce) ? null : _stepsToReproduce.Trim(),
            ExpectedOrImpact = string.IsNullOrWhiteSpace(_expectedOrImpact) ? null : _expectedOrImpact.Trim(),
            Context = CloneContext(_context)
        };

        PayloadSanitizer.Sanitize(previewReport, Options);

        return System.Text.Json.JsonSerializer.Serialize(previewReport, new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true,
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        });
    }

    private static BugContextSnapshot CloneContext(BugContextSnapshot source) => new()
    {
        CurrentRoute = source.CurrentRoute,
        BrowserInfo = source.BrowserInfo,
        ScreenSize = source.ScreenSize,
        SignalRState = source.SignalRState,
        AppName = source.AppName,
        AppVersion = source.AppVersion,
        Environment = source.Environment,
        CollectedAtUtc = source.CollectedAtUtc,
        TraceId = source.TraceId,
        CorrelationId = source.CorrelationId,
        SessionId = source.SessionId,
        PageInstanceId = source.PageInstanceId,
        SuggestedCategory = source.SuggestedCategory,
        CustomContext = new Dictionary<string, string>(source.CustomContext),
        RecentRequests = source.RecentRequests.Select(r => new HttpActivityEntry
        {
            Method = r.Method,
            Url = r.Url,
            StatusCode = r.StatusCode,
            DurationMs = r.DurationMs,
            TimestampUtc = r.TimestampUtc,
            ErrorSnippet = r.ErrorSnippet,
            TraceId = r.TraceId,
            CorrelationId = r.CorrelationId
        }).ToList(),
        RecentJsErrors = source.RecentJsErrors.Select(e => new JsErrorEntry
        {
            Message = e.Message,
            Source = e.Source,
            Line = e.Line,
            Column = e.Column,
            TimestampUtc = e.TimestampUtc,
            StackTrace = e.StackTrace
        }).ToList(),
        // B1 fields must be cloned too, otherwise the sanitized preview ("Ver detalhes
        // tecnicos") omits memory/console/breadcrumb data that is actually sent --
        // breaking the consent contract (preview must reflect the real payload).
        Memory = source.Memory is null ? null : new MemoryInfo
        {
            JsHeapUsedBytes = source.Memory.JsHeapUsedBytes,
            JsHeapTotalBytes = source.Memory.JsHeapTotalBytes,
            JsHeapLimitBytes = source.Memory.JsHeapLimitBytes,
            ManagedHeapBytes = source.Memory.ManagedHeapBytes
        },
        RecentConsoleErrors = source.RecentConsoleErrors.Select(c => new ConsoleErrorEntry
        {
            Message = c.Message,
            Stack = c.Stack,
            TimestampUtc = c.TimestampUtc
        }).ToList(),
        Breadcrumbs = source.Breadcrumbs.Select(b => new BreadcrumbEntry
        {
            Type = b.Type,
            Detail = b.Detail,
            TimestampUtc = b.TimestampUtc
        }).ToList()
    };
}
